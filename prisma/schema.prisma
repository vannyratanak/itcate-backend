// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GroupOption {
  id         Int                     @id @default(autoincrement())
  name       String
  sort_order Int                     @default(0)
  created_at DateTime                @default(now())
  updated_at DateTime                @updatedAt
  options    GroupOptionWithOption[]
  menuOption MenuQuestion[]
}

model GroupOptionWithOption {
  id Int @id @default(autoincrement())
  option_id       Int
  group_option_id Int
  option          Option      @relation(fields: [option_id], references: [id])
  groupOption     GroupOption @relation(fields: [group_option_id], references: [id])
}

model Option {
  id           Int                     @id @default(autoincrement())
  name_kh      String?
  name_en      String?
  created_at   DateTime                @default(now())
  updated_at   DateTime                @updatedAt
  options      GroupOptionWithOption[]
  survayOption SurvayerOption[]
}

model MenuQuestion {
  id              Int              @id @default(autoincrement())
  name_kh         String?
  name_en         String?
  group_option_id Int
  sort_order      Int              @default(0)
  group_option    GroupOption      @relation(fields: [group_option_id], references: [id])
  menuQuestion    SurvayerOption[]

}

model Survayer {
  id           Int              @id @default(autoincrement())
  name         String
  phoneNumber  String
  dateVisit    DateTime         @default(now())
  usedToVisit  Boolean
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  survayOption SurvayerOption[]
  survayMessage SurvayerMessage[]
}

//@relations
model SurvayerOption {
  id         Int @id @default(autoincrement())
  menu_id     Int
  survayer_id Int
  option_id   Int
  menuQuestion MenuQuestion @relation(fields: [menu_id], references: [id])
  survay       Survayer     @relation(fields: [survayer_id], references: [id])
  option       Option       @relation(fields: [option_id], references: [id])
  @@unique([menu_id, survayer_id, option_id])
}
model SurvayerMessage{
  id  Int @id @default(autoincrement())
  survay_id Int
  message String?
  approved Boolean @default(false) // shown on the public Reviews page once an admin approves it
  location Json?  
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  survay Survayer @relation(fields: [survay_id],references: [id])
}

// Single-row table (id is always 1): the shop identity shown on the survey/menu front end.
model Shop {
  id         Int      @id @default(1)
  name       String
  title      String
  logo_url   String?
  updated_at DateTime @updatedAt
}

model MenuItem {
  id             Int      @id @default(autoincrement())
  name_en        String
  name_kh        String?
  description_en String?
  description_kh String?
  category_id    Int
  category       MenuCategory @relation(fields: [category_id], references: [id])
  price          Decimal  @db.Decimal(10, 2)
  image_url      String?
  tags           String[] @default([])   // e.g. spicy, vegetarian, vegan, halal, gluten-free
  chefs_pick     Boolean  @default(false)
  sort_order     Int      @default(0)
  active         Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model MenuCategory {
  id         Int        @id @default(autoincrement())
  name_en    String     @unique
  name_kh    String?
  sort_order Int        @default(0)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  items      MenuItem[]
}

// Pages built in the admin's GrapesJS editor and rendered by the front end at /<slug>.
model Page {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  title      String
  project    Json?    // GrapesJS project data, so the editor can reopen the page exactly
  html       String   @default("") @db.Text
  css        String   @default("") @db.Text
  published  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}


// ===================== Site expansion =====================

// One row (id = 1): contact details, opening hours and social links shown across the site.
model SiteSetting {
  id         Int      @id @default(1)
  phone      String?
  email      String?
  address_en String?
  address_kh String?
  map_url    String?   // Google Maps link
  map_embed  String?   // Google Maps embed src
  facebook   String?
  instagram  String?
  telegram   String?
  tiktok     String?
  hours      Json?     // [{ day: 0-6 (Mon=0), open: "10:00", close: "22:00", closed: false }]
  notice     String?   // optional banner text, e.g. holiday closure
  updated_at DateTime @updatedAt
}

model Reservation {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String
  email      String?
  party_size Int
  date       DateTime @db.Date
  time       String   // "19:00"
  notes      String?
  status     String   @default("pending") // pending | confirmed | declined | cancelled
  admin_note String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  @@index([date])
}

model BlockedDate {
  id     Int      @id @default(autoincrement())
  date   DateTime @unique @db.Date
  reason String?
}

// Inbox for every public form: kind = contact | catering | gift_card | career
model ContactMessage {
  id         Int      @id @default(autoincrement())
  kind       String   @default("contact")
  name       String
  email      String?
  phone      String?
  subject    String?
  message    String
  data       Json?     // form-specific extras (event date, guests, job_id, amount...)
  status     String   @default("new") // new | read | replied | archived
  created_at DateTime @default(now())
  @@index([kind, status])
}

model Job {
  id             Int      @id @default(autoincrement())
  title_en       String
  title_kh       String?
  type_en        String?   // Full-time, Part-time...
  type_kh        String?
  description_en String?
  description_kh String?
  active         Boolean  @default(true)
  sort_order     Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model GalleryImage {
  id         Int      @id @default(autoincrement())
  url        String
  caption_en String?
  caption_kh String?
  sort_order Int      @default(0)
  active     Boolean  @default(true)
  created_at DateTime @default(now())
}

// kind = offer | event
model Offer {
  id         Int       @id @default(autoincrement())
  kind       String    @default("offer")
  title_en   String
  title_kh   String?
  body_en    String?
  body_kh    String?
  image_url  String?
  starts_at  DateTime?
  ends_at    DateTime?
  active     Boolean   @default(true)
  sort_order Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
}

model Faq {
  id          Int      @id @default(autoincrement())
  question_en String
  question_kh String?
  answer_en   String
  answer_kh   String?
  sort_order  Int      @default(0)
  active      Boolean  @default(true)
}

model BlogPost {
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  title_en     String
  title_kh     String?
  excerpt_en   String?
  excerpt_kh   String?
  cover_url    String?
  html_en      String    @default("")
  html_kh      String?
  published    Boolean   @default(false)
  published_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
}

// Staff logins. The ADMIN_USER/ADMIN_PASSWORD from .env stays as the "owner" bootstrap login.
model AdminUser {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  password_hash String
  role          String    @default("viewer") // owner | manager | viewer
  active        Boolean   @default(true)
  created_at    DateTime  @default(now())
  last_login_at DateTime?
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  actor      String
  role       String?
  method     String
  path       String
  status     Int
  summary    String?
  created_at DateTime @default(now())
  @@index([created_at])
}
